{
  "name": "cluely",
  "version": "0.1.6",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "tsx --env-file=.env.local scripts/db-push.ts",
    "desktop": "concurrently -k -n next,electron -c blue,magenta \"next dev\" \"wait-on http://localhost:3000/overlay && electron .\"",
    "desktop:only": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "node scripts/make-icon.js && electron-builder --win",
    "dist:dir": "node scripts/make-icon.js && electron-builder --win --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "electron scripts/sim/run.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "electron-updater": "^6.8.9",
    "jose": "^6.2.9",
    "lucide-react": "^1.32.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "packageManager": "pnpm@10.29.3",
  "main": "electron/main.js",
  "description": "Real-time AI meeting copilot — listens, answers on a hotkey, writes the notes.",
  "author": {
    "name": "Cluely"
  }
}
